#!/bin/sh
set -eu

lb config noauto \
  --distribution trixie \
  --architectures amd64 \
  --binary-images iso-hybrid \
  --archive-areas "main contrib non-free-firmware" \
  --debian-installer none \
  --image-name "fenriros-0.1-alpha" \
  --iso-application "FenrirOS Security Workstation" \
  --iso-volume "FENRIR_OS_0_1" \
  --bootappend-live "boot=live components hostname=fenriros username=fenrir" \
  "${@}"